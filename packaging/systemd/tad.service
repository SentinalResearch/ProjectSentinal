[Unit]
Description=terminal-agent persistent session daemon (compatibility; prefer sentinald.service)
# Kept through the Milestone 1b migration. Enable only one of tad/sentinald.
Conflicts=sentinald.service
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/tad
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
