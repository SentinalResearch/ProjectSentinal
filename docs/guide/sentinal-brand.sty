% ---------- fonts ----------
% XeLaTeX / LuaLaTeX: Archivo + JetBrains Mono from ./fonts (bundled).
% pdfLaTeX: Archivo from TeX Live (archivo package) + Inconsolata.
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \IfFileExists{archivo.sty}{\RequirePackage[sfdefault]{archivo}}{\RequirePackage[scaled=0.92]{tgheros}}
  \IfFileExists{zi4.sty}{\RequirePackage[varqu,varl,scaled=0.9]{zi4}}{}
  \renewcommand{\familydefault}{\sfdefault}
  \newcommand{\srdisplay}{\bfseries}
\else
  \RequirePackage{fontspec}
  \IfFileExists{fonts/Archivo-Regular.ttf}{%
    \setmainfont{Archivo}[Path=fonts/,Extension=.ttf,UprightFont=*-Regular,BoldFont=*-Bold,ItalicFont=*-Italic,BoldItalicFont=*-BoldItalic]%
    \setsansfont{Archivo}[Path=fonts/,Extension=.ttf,UprightFont=*-Regular,BoldFont=*-Bold,ItalicFont=*-Italic,BoldItalicFont=*-BoldItalic]%
    \newfontfamily\srdisplayfont{Archivo}[Path=fonts/,Extension=.ttf,UprightFont=*-ExtraBold,BoldFont=*-ExtraBold,ItalicFont=*-ExtraBold]%
  }{%
    \setmainfont{texgyreheros}[Extension=.otf,UprightFont=*-regular,BoldFont=*-bold,ItalicFont=*-italic,BoldItalicFont=*-bolditalic]%
    \setsansfont{texgyreheros}[Extension=.otf,UprightFont=*-regular,BoldFont=*-bold,ItalicFont=*-italic,BoldItalicFont=*-bolditalic]%
    \newfontfamily\srdisplayfont{texgyreheros}[Extension=.otf,UprightFont=*-bold,BoldFont=*-bold,ItalicFont=*-bold]%
  }
  \IfFileExists{fonts/JetBrainsMono-Regular.ttf}{%
    \setmonofont{JetBrainsMono}[Path=fonts/,Extension=.ttf,UprightFont=*-Regular,BoldFont=*-Bold,ItalicFont=*-Regular,Scale=0.86]%
  }{}
  \renewcommand{\familydefault}{\sfdefault}
  \newcommand{\srdisplay}{\srdisplayfont}
\fi

% ---------- marks ----------
% \srmark[size]        Sentinal Research: slash + ring
% \sentinalmark[size]  Sentinal (product): slash + filled dot
% Ink colour: \colorlet{srMarkInk}{srNightText} on dark backgrounds.
\newcommand{\srmark}[1][1em]{{\pgfmathsetlengthmacro\sru{(#1)/24}%
\begin{tikzpicture}[x=\sru,y=-\sru,baseline={(0pt,-#1)}]%
\path[use as bounding box] (0,0) rectangle (24,24);%
\draw[srMarkInk,line width=3.4*\sru,line cap=rect] (5,22)--(13.5,2);%
\draw[srBlue,line width=2.2*\sru] (18,18.5) circle[radius=3.1];%
\end{tikzpicture}}}
\newcommand{\sentinalmark}[1][1em]{{\pgfmathsetlengthmacro\sru{(#1)/24}%
\begin{tikzpicture}[x=\sru,y=-\sru,baseline={(0pt,-#1)}]%
\path[use as bounding box] (0,0) rectangle (24,24);%
\draw[srMarkInk,line width=3.4*\sru,line cap=rect] (5,22)--(13.5,2);%
\fill[srBlue] (18,18.5) circle[radius=3.4];%
\end{tikzpicture}}}
\newcommand{\srlockup}[1][14pt]{\mbox{\srmark[#1]\hspace{0.45em}{\fontsize{#1}{#1}\selectfont\srdisplay Sentinal\ \normalfont\color{srLockupSub}Research}}}
\newcommand{\sentinallockup}[1][14pt]{\mbox{\sentinalmark[#1]\hspace{0.45em}{\fontsize{#1}{#1}\selectfont\srdisplay Sentinal}}}

% ---------- state badge: \srstate{RUNNING} ----------
\newcommand{\srstate}[1]{{\setlength{\fboxsep}{1.8pt}\colorbox{srState-#1}{\hspace{2pt}\color{srInk}\scriptsize\bfseries\vphantom{Ag}#1\hspace{2pt}}}}

