# Sentinal external shell hook for fish (COMMANDS capture).
# Generated by `sentinal hook fish`. It reports Command text, cwd, timing, and
# exit status to the private sentinald socket in the background. It never reads
# terminal output or keystrokes and never prints anything; the Ctrl-Space
# completion widget at the end reads the line being typed only when pressed.
if status is-interactive; and not set -q SENTINAL_SESSION_ID; and test "$SENTINAL_DISABLE" != 1; and not set -q __sentinal_hook_loaded
    set -g __sentinal_hook_loaded 1
    set -g __sentinal_seq 0
    set -g __sentinal_text ''

    function __sentinal_report
        if set -q SENTINAL_SESSION_ID; or test "$SENTINAL_DISABLE" = 1
            return 0
        end
        SENTINAL_HOOK_TEXT=$__sentinal_text @SENTINAL_BIN@ hook report $argv --pid $fish_pid --shell fish </dev/null >/dev/null 2>&1 &
        disown $last_pid 2>/dev/null
    end

    function __sentinal_preexec --on-event fish_preexec
        set -g __sentinal_seq (math $__sentinal_seq + 1)
        set -g __sentinal_text $argv[1]
        set -g __sentinal_active 1
        __sentinal_report start --seq $__sentinal_seq
    end

    function __sentinal_postexec --on-event fish_postexec
        set -l __sentinal_status $status
        if set -q __sentinal_active
            set -e __sentinal_active
            __sentinal_report finish --seq $__sentinal_seq --exit $__sentinal_status
        end
    end

    __sentinal_report register
end

# Ctrl-Space completes the line from this Machine's history (`sentinal
# complete`, Milestone 5.A); press it again for the next suggestion. It reads
# the line only when pressed, passes it in the environment (never argv), and
# leaves Tab completion alone. It works in Sentinal terminals too.
if status is-interactive; and test "$SENTINAL_DISABLE" != 1; and not set -q __sentinal_complete_loaded
    set -g __sentinal_complete_loaded 1
    set -g __sentinal_complete_list
    set -g __sentinal_complete_index 0
    set -g __sentinal_complete_shown ''

    function __sentinal_complete
        if test (commandline -b) != "$__sentinal_complete_shown"; or test (count $__sentinal_complete_list) -eq 0
            set -g __sentinal_complete_list (SENTINAL_COMPLETE_PREFIX=(commandline -cb | string collect) @SENTINAL_BIN@ complete --cwd $PWD </dev/null 2>/dev/null)
            set -g __sentinal_complete_index 0
        end
        test (count $__sentinal_complete_list) -eq 0; and return 0
        set -g __sentinal_complete_index (math $__sentinal_complete_index % (count $__sentinal_complete_list) + 1)
        set -g __sentinal_complete_shown $__sentinal_complete_list[$__sentinal_complete_index]
        commandline -r -- $__sentinal_complete_shown
        commandline -f end-of-line
    end

    if test (string split . $version)[1] -ge 4
        bind ctrl-space __sentinal_complete
    else
        bind -k nul __sentinal_complete
    end
end
