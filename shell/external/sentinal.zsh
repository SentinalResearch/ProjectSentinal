# Sentinal external shell hook for zsh (COMMANDS capture).
# Generated by `sentinal hook zsh`. It reports Command text, cwd, timing, and
# exit status to the private sentinald socket in the background. It never reads
# terminal output or keystrokes and never prints anything; the Ctrl-Space
# completion widget at the end reads the line being typed only when pressed.
if [[ -o interactive && -z "${SENTINAL_SESSION_ID-}" && "${SENTINAL_DISABLE-}" != 1 && -z "${__sentinal_hook_loaded-}" ]]; then
  typeset -g __sentinal_hook_loaded=1 __sentinal_seq=0 __sentinal_active= __sentinal_text=
  zmodload -F zsh/datetime p:EPOCHREALTIME 2>/dev/null
  autoload -Uz add-zsh-hook

  __sentinal_report() {
    [[ -n "${SENTINAL_SESSION_ID-}" || "${SENTINAL_DISABLE-}" == 1 ]] && return 0
    # Background through a subshell so the reporter is never this shell's
    # job: its exit must not reach ZLE while the prompt is drawn (that can
    # leave zsh waiting for input with no prompt shown). $$ stays this shell.
    ( SENTINAL_HOOK_TEXT="$__sentinal_text" @SENTINAL_BIN@ hook report "$@" --pid $$ --shell zsh --at "${EPOCHREALTIME-}" </dev/null >/dev/null 2>&1 & )
  }

  __sentinal_preexec() {
    (( ++__sentinal_seq ))
    __sentinal_active=1
    __sentinal_text=$1
    __sentinal_report start --seq $__sentinal_seq
  }

  __sentinal_precmd() {
    local __sentinal_status=$?
    if [[ -n $__sentinal_active ]]; then
      __sentinal_active=
      __sentinal_report finish --seq $__sentinal_seq --exit $__sentinal_status
    fi
    return $__sentinal_status
  }

  add-zsh-hook preexec __sentinal_preexec
  # First, so the Command's own exit status is what gets reported.
  precmd_functions=(__sentinal_precmd ${precmd_functions:#__sentinal_precmd})
  __sentinal_report register
fi

# Ctrl-Space completes the line from this Machine's history (`sentinal
# complete`, Milestone 5.A); press it again for the next suggestion. It reads
# the line only when pressed, passes it in the environment (never argv), and
# leaves Tab completion alone. It works in Sentinal terminals too.
if [[ -o interactive && "${SENTINAL_DISABLE-}" != 1 && -z "${__sentinal_complete_loaded-}" ]]; then
  typeset -g __sentinal_complete_loaded=1 __sentinal_complete_index=0 __sentinal_complete_shown=
  typeset -ga __sentinal_complete_list

  __sentinal_complete() {
    # Pressed again on the line it just inserted: the next suggestion.
    if [[ -z $__sentinal_complete_shown || $LBUFFER != "$__sentinal_complete_shown" ]]; then
      __sentinal_complete_list=("${(@f)$(SENTINAL_COMPLETE_PREFIX=$LBUFFER @SENTINAL_BIN@ complete --cwd "$PWD" </dev/null 2>/dev/null)}")
      __sentinal_complete_list=(${__sentinal_complete_list:#})
      __sentinal_complete_index=0
    fi
    if (( ${#__sentinal_complete_list} == 0 )); then
      zle -M "sentinal: nothing to complete"
      return 0
    fi
    (( __sentinal_complete_index = __sentinal_complete_index % ${#__sentinal_complete_list} + 1 ))
    LBUFFER=${__sentinal_complete_list[__sentinal_complete_index]}
    __sentinal_complete_shown=$LBUFFER
    zle -M "sentinal ${__sentinal_complete_index}/${#__sentinal_complete_list} · Ctrl-Space for the next"
  }

  zle -N __sentinal_complete
  bindkey '^@' __sentinal_complete
fi
