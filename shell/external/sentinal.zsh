# Sentinal external shell hook for zsh (COMMANDS capture).
# Generated by `sentinal hook zsh`. It reports Command text, cwd, timing, and
# exit status to the private sentinald socket in the background. It never reads
# terminal output or keystrokes and never prints anything.
if [[ -o interactive && -z "${SENTINAL_SESSION_ID-}" && "${SENTINAL_DISABLE-}" != 1 && -z "${__sentinal_hook_loaded-}" ]]; then
  typeset -g __sentinal_hook_loaded=1 __sentinal_seq=0 __sentinal_active= __sentinal_text=
  zmodload -F zsh/datetime p:EPOCHREALTIME 2>/dev/null
  autoload -Uz add-zsh-hook

  __sentinal_report() {
    [[ -n "${SENTINAL_SESSION_ID-}" || "${SENTINAL_DISABLE-}" == 1 ]] && return 0
    SENTINAL_HOOK_TEXT="$__sentinal_text" @SENTINAL_BIN@ hook report "$@" --pid $$ --shell zsh --at "${EPOCHREALTIME-}" </dev/null >/dev/null 2>&1 &!
  }

  __sentinal_preexec() {
    (( ++__sentinal_seq ))
    __sentinal_active=1
    __sentinal_text=$1
    __sentinal_report start --seq $__sentinal_seq
  }

  __sentinal_precmd() {
    local __sentinal_status=$?
    if [[ -n $__sentinal_active ]]; then
      __sentinal_active=
      __sentinal_report finish --seq $__sentinal_seq --exit $__sentinal_status
    fi
    return $__sentinal_status
  }

  add-zsh-hook preexec __sentinal_preexec
  # First, so the Command's own exit status is what gets reported.
  precmd_functions=(__sentinal_precmd ${precmd_functions:#__sentinal_precmd})
  __sentinal_report register
fi
